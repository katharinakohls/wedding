---
import "../styles/global.css";
import heroImg from "../assets/photos/hero.jpg";
import p1 from "../assets/photos/img-1.jpg";
import p2 from "../assets/photos/img-2.jpg";
import p4 from "../assets/photos/img-4.jpg";
import p5 from "../assets/photos/img-5.jpg";
import p6 from "../assets/photos/img-6.jpg";
import p7 from "../assets/photos/img-7.jpg";
import washLeft from "../assets/aqua_left.png";
import washRight from "../assets/aqua_right.png";


 const gallery = [p1, p2, p4, p5, p6, p7];
const dateText = "15.08.2026";
const placeText = "folgt";
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500,650&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<html lang="de">

<div class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#">Katharina & David</a>

    <nav class="nav-links">

      <a class="nav-cta" href="#rsvp">Zusagen</a>
    </nav>
  </div>
</div>

<header class="hero">
  <div class="hero-wash hero-wash-left" aria-hidden="true">
    <img src={washLeft.src} alt="" />
  </div>

  <div class="hero-wash hero-wash-right" aria-hidden="true">
    <img src={washRight.src} alt="" />
  </div>

  <div class="container hero-inner">
    <div class="hero-photo card">
      <img src={heroImg.src} alt="Foto von uns" loading="eager" />
    </div>

    <h1 class="headline">Katharina & David</h1>

    <div class="hero-glass">
      <div class="small" style="color: var(--text); font-weight: 600;">
        15. August 2026
      </div>
    </div>

    <p class="subline">
      Wir freuen uns riesig, diesen Tag mit euch zu teilen. Alle Details findet ihr weiter unten 🤍
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#rsvp">Zusagen</a>
      <a class="btn btn-ghost" href="#details">Infos</a>
    </div>
  </div>
</header>



<main>
  <section id="galerie" class="section">
  <div class="container">
    <div class="gallery">
      {gallery.map((img, i) => (
        <a class="gallery-item" href={img.src} target="_blank" rel="noreferrer">
          <img src={img.src} alt={`Foto ${i + 1}`} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</section>

  <section id="details" class="section">
  <div class="container">
    <h2 class="h2">Der Tag</h2>
    <p class="small">
      Die Trauung beginnt um 14:00 Uhr. Wir freuen uns, wenn ihr euch ein paar Minuten vorher an der Kirche einfindet.
    </p>

    <div class="card" style="padding:24px; margin-top:16px;">
      <div class="timeline">

        <div class="timeline-item">
          <div class="time">14:00</div>
          <div class="content">
            <strong>Trauung</strong><br>
            Martin-Luther-Kirche, Bergkamen
          </div>
        </div>

        <div class="timeline-item">
          <div class="time">ca. 14:45</div>
          <div class="content">
            <strong>Gratulationen</strong><br>
            an der Kirche
          </div>
        </div>

        <div class="timeline-item">
          <div class="time">danach</div>
          <div class="content">
            <strong>Empfang</strong><br>
            an der Ökologiestation
          </div>
        </div>

        <div class="timeline-item">
          <div class="time">19:00</div>
          <div class="content">
            <strong>Abendessen</strong>
          </div>
        </div>

        <div class="timeline-item">
          <div class="time">danach</div>
          <div class="content">
            <strong>Reden & Beiträge</strong>
          </div>
        </div>

        <div class="timeline-item">
          <div class="time">später</div>
          <div class="content">
            <strong>Eröffnungstanz & Party</strong><br>
            Live-Musik und anschließend DJ
          </div>
        </div>

        <div class="timeline-item">
          <div class="time">00:00</div>
          <div class="content">
            <strong>Mitternachtssnack</strong>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<section id="trauung" class="section">
  <div class="container">
    <h2 class="h2">Trauung</h2>

    <div class="card" style="padding:20px;">
      <div class="small">
        Die Trauung findet in der Martin-Luther-Kirche in Bergkamen statt.<br><br>

        Martin-Luther-Kirche<br>
        Preinstraße 38<br>
        59192 Bergkamen<br><br>

        Im Anschluss freuen wir uns auf Gratulationen vor der Kirche, bevor wir zur Ökologiestation weiterziehen.
      </div>
    </div>
  </div>
</section>

  <section id="anreise" class="section">
  <div class="container">

    <h2 class="h2">Anreise</h2>

    <!-- obere Reihe -->
    <div class="anreise-top">

      <div class="card info-card">
        <strong>Adresse</strong>

        <p class="small">
          Ökologiestation<br>
          Doktor-Detlef-Timpe-Weg 1<br>
          59192 Bergkamen
        </p>
      </div>

      <div class="card info-card">
        <strong>Parken</strong>

        <p class="small">
          Direkt an der Ökologiestation
        </p>
      </div>

    </div>

    <!-- Hotels -->
    <div class="hotel-section">

      <h3 class="h2">Unterkunft</h3>

      <div class="hotel-grid">

        <div class="card hotel-card">
          <strong>Zu Freunden</strong>

          <div class="small">
            9 Minuten · 7 km
          </div>

          <a class="hotel-link"
             href="https://www.zu-freunden.de/"
             target="_blank"
             rel="noreferrer">
            Website ansehen
          </a>
        </div>

        <div class="card hotel-card">
          <strong>Pension Waldblick</strong>

          <div class="small">
            7 Minuten · 5,2 km
          </div>

          <a class="hotel-link"
             href="https://www.pensionwaldblick.com/"
             target="_blank"
             rel="noreferrer">
            Website ansehen
          </a>
        </div>

        <div class="card hotel-card">
          <strong>Hotel am Kloster</strong>

          <div class="small">
            8 Minuten · 5,4 km
          </div>

          <a class="hotel-link"
             href="https://hotel-am-kloster.de/kontakt"
             target="_blank"
             rel="noreferrer">
            Website ansehen
          </a>
        </div>

        <div class="card hotel-card">
          <strong>Baumhove</strong>

          <div class="small">
            9 Minuten · 5 km
          </div>

          <a class="hotel-link"
             href="https://baumhove.de/"
             target="_blank"
             rel="noreferrer">
            Website ansehen
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

  <section id="rsvp" class="section">
  <div class="container">
    <div class="card" style="
      padding:26px;
      display:flex;
      gap:18px;
      align-items:center;
      justify-content:center;
      flex-wrap:wrap;
      text-align:center;
    ">
      <div>
        <div class="h2">Save the Date</div>
        <div class="small">
          Wir freuen uns riesig, diesen Tag mit euch zu feiern.<br>
          Wenn ihr mögt, gebt uns schon jetzt eine kurze Rückmeldung –
          alles ganz unverbindlich 🤍
        </div>
      </div>

      <a
        class="btn btn-primary"
        href="https://docs.google.com/forms/d/e/1FAIpQLSfkyaUg43k920lsZ_ljgG9C-OvtFixs4ljZecZF8ZBzPydUGg/viewform?usp=dialog"
        target="_blank"
        rel="noopener noreferrer"
      >
        Zum Formular
      </a>
    </div>
  </div>
</section>

<section id="faq" class="section">
  <div class="container">
    <h2 class="h2">FAQ</h2>

    <div class="card" style="padding:20px;">
      <div class="small">
        <strong>Bis wann sollen wir zusagen?</strong><br>
        Am besten so bald wie möglich über das Formular.<br><br>

        <strong>Kann ich meine Antwort später noch ändern?</strong><br>
        Ja, das geht jederzeit über den Link aus der Bestätigungsmail.<br><br>

        <strong>Gibt es einen Dresscode?</strong><br>
        Ja – wir freuen uns über Natur- und Pastelltöne, aber das ist kein Muss.<br><br>

        <strong>Gibt es Übernachtungsmöglichkeiten?</strong><br>
        Dazu sammeln wir gerade Vorschläge und ergänzen sie bald hier.
      </div>
    </div>
  </div>
</section>

</main>

<footer class="section" style="padding-top:10px;">
  <div class="container small">© {new Date().getFullYear()} Katharina & David</div>
</footer>