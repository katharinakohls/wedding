---
import "../styles/global.css";
import heroImg from "../assets/photos/hero.jpg";
import p1 from "../assets/photos/img-1.jpg";
import p2 from "../assets/photos/img-2.jpg";
import p4 from "../assets/photos/img-4.jpg";
import p5 from "../assets/photos/img-5.jpg";
import p6 from "../assets/photos/img-6.jpg";
import p7 from "../assets/photos/img-7.jpg";


 const gallery = [p1, p2, p4, p5, p6, p7];
const dateText = "15.08.2026";
const placeText = "folgt";
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500,650&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<html lang="de">

<div class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#">Katharina & David</a>

    <nav class="nav-links">

      <a class="nav-cta" href="#rsvp">Zusagen</a>
    </nav>
  </div>
</div>

<header class="hero">
  <div class="container hero-inner">
    <div class="kicker">
      <span class="scroll-dot" aria-hidden="true"></span>
      <span>Save the date</span>
    </div>

    <div class="hero-photo card">
    <img src={heroImg.src} alt="Foto von uns" loading="eager" />
  </div>

    <h1 class="headline">Katharina & David</h1>

    <div class="hero-glass">
      <div class="small" style="color: var(--text); font-weight: 600;">
        15.08.2026 · <a href="http://xn--kologiestation-upb.info/kontakt/anfahrt/">Ökologiestation</a>
      </div>
    </div>

    <p class="subline">
      Wir freuen uns riesig, diesen Tag mit euch zu teilen. Alle Details findet ihr weiter unten 🤍
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#rsvp">Zusagen</a>
      <a class="btn btn-ghost" href="#details">Infos</a>
    </div>

    <section id="galerie" class="section">
  <div class="container">

    <div class="gallery">
      {gallery.map((img, i) => (
        <a class="gallery-item" href={img.src} target="_blank" rel="noreferrer">
          <img src={img.src} alt={`Foto ${i + 1}`} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</section>

    </a>
  </div>
</header>

<main>


  <section id="anreise" class="section">
    <div class="container">
      <h2 class="h2">Anreise</h2>
      <div class="grid grid-3">
        <div class="card" style="padding:18px;">
          <strong>Adresse</strong>
          <p class="small">Ökologiestation<br>Doktor-Detlef-Timpe-Weg 1, 59192 Bergkamen</p>
        </div>
        <div class="card" style="padding:18px;">
          <strong>Parken</strong>
          <p class="small">Direkt an der Ökologiestation</p>
        </div>
        <div class="card" style="padding:18px;">
          <strong>Unterkunft</strong>
          <p class="small">Vorschläge kommen noch :)</p>
        </div>
      </div>
    </div>
  </section>

  <section id="rsvp" class="section">
  <div class="container">
    <div class="card" style="
      padding:26px;
      display:flex;
      gap:18px;
      align-items:center;
      justify-content:center;
      flex-wrap:wrap;
      text-align:center;
    ">
      <div>
        <div class="h2">Save the Date</div>
        <div class="small">
          Wir freuen uns riesig, diesen Tag mit euch zu feiern.<br>
          Wenn ihr mögt, gebt uns schon jetzt eine kurze Rückmeldung –
          alles ganz unverbindlich 🤍
        </div>
      </div>

      <a
        class="btn btn-primary"
        href="https://docs.google.com/forms/d/e/1FAIpQLSfkyaUg43k920lsZ_ljgG9C-OvtFixs4ljZecZF8ZBzPydUGg/viewform?usp=dialog"
        target="_blank"
        rel="noopener noreferrer"
      >
        Zum Formular
      </a>
    </div>
  </div>
</section>
</main>

<footer class="section" style="padding-top:10px;">
  <div class="container small">© {new Date().getFullYear()} Katharina & David</div>
</footer>